{
  "manifest_version": 3,
  "name": "ClickFix Guard",
  "version": "1.1.0",
  "description": "Detects suspicious fake verification pages and ClickFix-style operating-system instructions.",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "ClickFix Guard"
  }
}